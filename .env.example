# Development mode uses local Ollama when no hosted provider key is configured.
TRUSTRAG_ENV=development
TRUSTRAG_OLLAMA_URL=http://127.0.0.1:11434
TRUSTRAG_OLLAMA_MODEL=llama3.2:3b

# Production answer generation uses a server-side OpenAI-compatible provider.
# Never commit real secrets or paste API keys into public source files.
TRUSTRAG_LLM_API_KEY=
TRUSTRAG_LLM_BASE_URL=https://api.openai.com/v1
TRUSTRAG_LLM_MODEL=gpt-4o-mini

# Supply a stable random value with at least 32 characters for production.
TRUSTRAG_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
TRUSTRAG_DATABASE_PATH=data/trustrag.sqlite3
TRUSTRAG_DATA_DIR=data
